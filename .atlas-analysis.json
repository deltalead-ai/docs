  "keyFeatures": [
    "AI agents that qualify leads via WhatsApp, calls, email, and web forms 24/7",
    "Omnichannel unified inbox — all channels merged into a single lead profile",
    "AI-powered phone calls with natural speech and human handoff",
    "Lead scoring by purchase intent, budget, and urgency",
    "Automated follow-up sequences with configurable cadences",
    "Vehicle lifecycle management with integrated DMS",
    "Real-time campaign analytics (Meta Ads, Google Ads, organic)",
    "Outbound WhatsApp campaigns with audience segmentation",
    "CRM/DMS integrations (Salesforce, HubSpot, Pipedrive, Odoo, Tecnom, PilotSolution, Dynamics 365)",
    "REST API and webhooks for custom integrations",
    "Multi-language and regional Spanish variants (AR, MX, CR, CO, PT-BR, EN-US)"
  ],
  "publicApiSurface": [
    "GET /v1/leads — List leads with filters",
    "GET /v1/leads/{id} — Retrieve a lead",
    "POST /v1/leads — Create a lead",
    "PATCH /v1/leads/{id} — Update a lead",
    "GET /v1/conversations — List conversations",
    "GET /v1/conversations/{id} — Retrieve a conversation",
    "POST /v1/conversations/{id}/messages — Send a message",
    "GET /v1/agents — List AI agents",
    "GET /v1/agents/{id} — Retrieve an agent",
    "PATCH /v1/agents/{id} — Update agent configuration",
    "POST /v1/webhooks — Register a webhook endpoint",
    "Webhook events: lead.created, lead.qualified, lead.updated, conversation.started, conversation.message.received, appointment.scheduled"
  ]
